# Skopiuj do .env i uzupełnij. Nie commituj prawdziwych sekretów.

# --- Adresy ---
NEXT_PUBLIC_BASE_URL=https://serwiswrybnej.pl
API_URL=http://127.0.0.1:8000
MEDIA_FALLBACK_URL=

# --- Opis strony (SEO) ---
NEXT_PUBLIC_SITE_NAME=
